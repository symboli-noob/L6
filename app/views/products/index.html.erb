<h1>商品一覧</h1>

<p>
  <%= link_to "商品を登録する", new_product_path %>
</p>

<p>
  <%= link_to "カートを見る", cart_path %>
</p>

<hr>

<table border="1">
  <thead>
    <tr>
      <th>商品名</th>
      <th>価格</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>

        <td>
          <%= number_to_currency(
            product.price,
            unit: "¥",
            precision: 0
          ) %>
        </td>

        <td>
          <%= button_to "カートに追加",
              cart_items_path(product_id: product.id),
              method: :post %>

          <%= button_to "商品を削除",
              product_path(product),
              method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>